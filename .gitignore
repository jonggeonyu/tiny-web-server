# 빌드 결과물 (Makefile이 build/에 .o, bin/에 실행 파일을 만든다)
build/
bin/
*.o
*.d
*.a
*.so

# 실행 파일을 루트에 만들었을 때 대비
/webserver
/proxy
/test_*

# 디버깅·sanitizer 부산물
core
core.*
vgcore.*
*.dSYM/
*.gcda
*.gcno
*.gcov

# 서버 실행 로그와 테스트 중 생기는 임시 파일
*.log
*.pid
tests/tmp/

# 부하 테스트 원본 출력 (README에 정리한 표만 커밋)
bench/raw/

# 에디터·OS
.vscode/
.idea/
*.swp
*~
.DS_Store

# 개인 Claude 설정
.claude/settings.local.json
